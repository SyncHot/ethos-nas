#!/usr/bin/env python3
"""ethos-pack — build and sign an EthOS package repository.

Commands:
  keygen  --out-dir DIR                 write repo.key (0600) + repo.pub
  build   --repo DIR --base-url URL     hash local files, write manifests + index.json
  sign    --repo DIR --key repo.key     write index.json.sig
  verify  --repo DIR [--pub repo.pub]   verify signature + manifest/file hashes
  lint    --repo DIR                    catalog hygiene: pins, restart policies, README drift
  readme  --repo DIR                    regenerate the README catalog table from index.json

The signed payload is the raw bytes of index.json. Hashes cover every manifest,
compose file and declared file, so a repository cannot be changed after signing
without the private key.
"""

import argparse
import base64
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml
from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey

ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$")
RESERVED = {"packages", "trash", "snapshots", "thumbnails", "temp_chunks", "wallpapers",
            "git", "models", "temp", "users", "desktop_layouts", "app_events",
            "agent-cache", "backup", "shares", "share_links"}
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
WHEEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,200}\.whl$")
# Tags that move under the signed compose file: a rebuild would not be a rebuild.
FLOATING_TAGS = {"latest", "stable", "edge", "main", "master", "nightly", "beta",
                 "alpha", "dev", "unstable", "release", "rolling"}


def _wheel_arch(filename: str) -> str:
    """Infer the manifest arch key from a wheel file name."""
    if filename.endswith("-none-any.whl"):
        return "any"
    if "aarch64" in filename:
        return "aarch64"
    if "x86_64" in filename or "amd64" in filename:
        return "x86_64"
    raise ValueError(
        f"cannot infer the architecture of {filename}; set \"arch\" explicitly",
    )


def _sha(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def _write_json(path: Path, value: dict) -> bytes:
    payload = (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
    path.write_bytes(payload)
    return payload


def cmd_keygen(args) -> int:
    out = Path(args.out_dir)
    out.mkdir(parents=True, exist_ok=True)
    private = Ed25519PrivateKey.generate()
    key_path = out / "repo.key"
    pub_path = out / "repo.pub"
    if key_path.exists() and not args.force:
        print(f"refusing to overwrite {key_path} (use --force)", file=sys.stderr)
        return 1
    raw_private = private.private_bytes_raw()
    key_path.write_bytes(base64.b64encode(raw_private) + b"\n")
    os.chmod(key_path, 0o600)
    pub_path.write_bytes(base64.b64encode(private.public_key().public_bytes_raw()) + b"\n")
    print(f"wrote {key_path} (keep private) and {pub_path}")
    return 0


def _normalize_manifest(pkg_dir: Path, manifest: dict, base_url: str) -> tuple[dict, int]:
    pkg_id = str(manifest.get("id") or "")
    if not ID_RE.fullmatch(pkg_id) or pkg_id in RESERVED:
        raise ValueError(f"invalid package id: {pkg_id!r}")
    for field in ("name", "version", "description", "icon"):
        if not str(manifest.get(field) or "").strip():
            raise ValueError(f"{pkg_id}: missing {field}")
    if manifest.get("scripts") and any(v for v in manifest["scripts"].values() if v):
        raise ValueError(f"{pkg_id}: lifecycle scripts are not supported")

    size = 0
    compose = manifest.get("compose")
    if isinstance(compose, str):
        compose_path = (pkg_dir / compose).resolve()
        if not compose_path.is_file() or pkg_dir.resolve() not in compose_path.parents:
            raise ValueError(f"{pkg_id}: compose file not found: {compose}")
        compose = {"url": f"{base_url}/{pkg_id}/{compose_path.name}", "sha256": _sha(compose_path)}
        size += compose_path.stat().st_size
    elif isinstance(compose, dict) and compose.get("url"):
        # A built manifest normally carries {url, sha256}. When the compose file
        # is committed next to it, that file is the source of truth: recompute so
        # editing the compose file cannot leave a stale hash behind (the index
        # would still verify, and the NAS would run the old file's contract).
        compose_name = str(compose["url"]).rstrip("/").rsplit("/", 1)[-1]
        local_path = pkg_dir / compose_name
        if compose_name and local_path.is_file():
            compose = {"url": f"{base_url}/{pkg_id}/{compose_name}", "sha256": _sha(local_path)}
            size += local_path.stat().st_size
        else:
            compose = {"url": compose["url"], "sha256": str(compose.get("sha256") or "").lower()}
            if not SHA_RE.fullmatch(compose["sha256"]):
                raise ValueError(f"{pkg_id}: compose.sha256 is missing")
    elif compose is not None:
        raise ValueError(f"{pkg_id}: compose must be a local path or {{url, sha256}}")
    if not compose and not manifest.get("files"):
        raise ValueError(f"{pkg_id}: package needs compose or files")

    files = []
    for item in manifest.get("files") or []:
        if isinstance(item, str):
            path = item
            mode = 0o644
        elif isinstance(item, dict):
            path = str(item.get("path") or "")
            mode = int(item.get("mode") or 0o644)
        else:
            raise ValueError(f"{pkg_id}: invalid files entry")
        pure = Path(path)
        if pure.is_absolute() or ".." in pure.parts:
            raise ValueError(f"{pkg_id}: file path must stay inside the package: {path}")
        absolute = (pkg_dir / pure).resolve()
        if not absolute.is_file() or pkg_dir.resolve() not in absolute.parents:
            raise ValueError(f"{pkg_id}: file not found: {path}")
        files.append({
            "url": f"{base_url}/{pkg_id}/{pure.as_posix()}",
            "sha256": _sha(absolute),
            "path": pure.as_posix(),
            "mode": mode & 0o777,
        })
        size += absolute.stat().st_size

    normalized = {
        **{k: v for k, v in manifest.items() if k not in ("compose", "files", "scripts", "compose_url", "python")},
        "schema": 2,
        "compose": compose,
        "files": files,
    }
    normalized.pop("scripts", None)
    # Every compose package needs the engine. Keep the index honest so cards can
    # badge it and the core preflight has an id to probe.
    if compose:
        requires = normalized.get("system_requires")
        requires = [str(item) for item in requires] if isinstance(requires, list) else []
        if "docker" not in requires:
            normalized["system_requires"] = ["docker", *requires]

    python = manifest.get("python")
    if python is not None:
        if not isinstance(python, dict):
            raise ValueError(f"{pkg_id}: python must be an object")
        entry = str(python.get("entry") or "")
        if entry not in {item["path"] for item in files}:
            raise ValueError(f"{pkg_id}: python.entry must be listed in files[]: {entry!r}")
        wheels = []
        seen = set()
        for item in python.get("wheels") or []:
            if isinstance(item, str):
                item = {"path": item}
            if not isinstance(item, dict):
                raise ValueError(f"{pkg_id}: invalid python.wheels entry")
            if item.get("url"):
                # Absolute, hash-pinned upstream wheel (e.g. a PyPI CDN file).
                # Integrity still comes from the signed manifest sha256; the
                # artifact is not copied into this repository.
                url = str(item["url"])
                if not url.startswith("https://"):
                    raise ValueError(f"{pkg_id}: wheel url must be https")
                filename = str(item.get("filename") or url.rsplit("/", 1)[-1])
                if not WHEEL_RE.fullmatch(filename):
                    raise ValueError(f"{pkg_id}: not a wheel: {filename}")
                sha = str(item.get("sha256") or "").strip().lower()
                if not SHA_RE.fullmatch(sha):
                    raise ValueError(f"{pkg_id}: upstream wheel needs a sha256")
                if filename in seen:
                    raise ValueError(f"{pkg_id}: duplicate wheel: {filename}")
                seen.add(filename)
                arch = str(item.get("arch") or "").strip().lower() or _wheel_arch(filename)
                wheels.append({"url": url, "sha256": sha, "arch": arch, "filename": filename})
                continue
            source = Path(str(item.get("path") or item.get("filename") or ""))
            if not source.is_absolute():
                source = pkg_dir / "wheels" / source
            source = source.resolve()
            if not source.is_file() or pkg_dir.resolve() not in source.parents:
                raise ValueError(f"{pkg_id}: wheel not found: {item.get('path') or item.get('filename')}")
            if not WHEEL_RE.fullmatch(source.name):
                raise ValueError(f"{pkg_id}: not a wheel: {source.name}")
            if source.name in seen:
                raise ValueError(f"{pkg_id}: duplicate wheel: {source.name}")
            seen.add(source.name)
            arch = str(item.get("arch") or "").strip().lower() or _wheel_arch(source.name)
            wheels.append({
                "url": f"{base_url}/{pkg_id}/wheels/{source.name}",
                "sha256": _sha(source),
                "arch": arch,
                "filename": source.name,
            })
            size += source.stat().st_size
        if not wheels and (python.get("requirements") or []):
            raise ValueError(f"{pkg_id}: runtime 'venv' needs python.wheels for its requirements")
        normalized["python"] = {
            "entry": entry,
            "port": int(python.get("port") or 0),
            "requirements": python.get("requirements") or [],
            "requires_python": python.get("requires_python"),
            "wheels": wheels,
        }
    return normalized, size


def cmd_build(args) -> int:
    repo = Path(args.repo).resolve()
    base_url = args.base_url.rstrip("/")
    index_path = repo / "index.json"
    entries = []
    for pkg_dir in sorted(p for p in repo.iterdir() if p.is_dir() and (p / "manifest.json").is_file()):
        manifest = _read_json(pkg_dir / "manifest.json")
        try:
            normalized, size = _normalize_manifest(pkg_dir, manifest, base_url)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        manifest_bytes = _write_json(pkg_dir / "manifest.json", normalized)
        entries.append({
            "id": normalized["id"],
            "name": normalized["name"],
            "version": normalized["version"],
            "description": normalized["description"],
            "icon": normalized.get("icon") or "📦",
            "icon_url": normalized.get("icon_url"),
            "category": normalized.get("category") or "other",
            "author": normalized.get("author") or "",
            "homepage": normalized.get("homepage"),
            "license": normalized.get("license") or "",
            "channel": normalized.get("channel") or "stable",
            "requires": normalized.get("requires") or [],
            "runtime": normalized.get("runtime") or ("compose" if normalized.get("compose") else "files"),
            "capabilities": normalized.get("capabilities") or (
                ["compose"] if normalized.get("compose") else []
            ),
            # Host software the package needs (probed by services/system_deps.py).
            # Kept in the index so cards can badge it without fetching a manifest.
            "system_requires": list(normalized.get("system_requires") or []),
            "screenshots": normalized.get("screenshots") or [],
            "changelog": normalized.get("changelog") or "",
            "manifest_url": f"{base_url}/{normalized['id']}/manifest.json",
            "manifest_sha256": hashlib.sha256(manifest_bytes).hexdigest(),
            "size_bytes": size,
        })

    published = _read_json(index_path) if index_path.exists() else {}
    index = {
        "schema": 2,
        "name": published.get("name") or repo.name,
        "publisher": published.get("publisher") or {},
        "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "packages": entries,
    }
    _write_json(index_path, index)
    print(f"built {index_path} with {len(entries)} package(s)")
    print("next: ethos-pack sign --repo", repo, "--key repo.key")
    return 0


def cmd_sign(args) -> int:
    repo = Path(args.repo)
    key_path = Path(args.key)
    raw = base64.b64decode(key_path.read_bytes().strip(), validate=True)
    private = Ed25519PrivateKey.from_private_bytes(raw)
    payload = (repo / "index.json").read_bytes()
    signature = private.sign(payload)
    (repo / "index.json.sig").write_bytes(base64.b64encode(signature) + b"\n")
    print(f"signed {repo / 'index.json'} -> index.json.sig")
    return 0


CATALOG_START = "<!-- catalog:start -->"
CATALOG_END = "<!-- catalog:end -->"


def _lint_manifest(pkg_dir: Path, manifest: dict) -> tuple[list[str], list[str]]:
    """Manifest/compose hygiene that the signature chain cannot express."""
    pkg_id = str(manifest.get("id") or pkg_dir.name)
    errors: list[str] = []
    warnings: list[str] = []
    if str(manifest.get("name") or "").strip() == pkg_id:
        errors.append(f"{pkg_id}: name must be the product name, not the package id")
    if not str(manifest.get("min_ethos_version") or "").strip():
        errors.append(f"{pkg_id}: min_ethos_version is required")
    ui = manifest.get("ui") or {}
    if ui:
        if (ui.get("mode") or "window") == "window" and not ui.get("port"):
            errors.append(f"{pkg_id}: a window ui needs a port")
        if ui.get("expose") == "lan" and ui.get("auth") not in ("package", "none"):
            errors.append(f"{pkg_id}: ui.expose 'lan' requires ui.auth 'package' or 'none'")
        if ui.get("expose", "loopback") == "loopback" and ui.get("auth"):
            errors.append(f"{pkg_id}: ui.auth requires ui.expose 'lan'")
    for url in manifest.get("screenshots") or []:
        if not str(url).startswith("https://"):
            errors.append(f"{pkg_id}: screenshot is not https: {url}")

    compose = manifest.get("compose")
    if compose:
        name = str((compose or {}).get("url") or "docker-compose.yml").rstrip("/").rsplit("/", 1)[-1]
        path = pkg_dir / name
        if not path.is_file():
            path = pkg_dir / "docker-compose.yml"
        if not path.is_file():
            errors.append(f"{pkg_id}: compose file is missing")
        else:
            try:
                doc = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
            except (yaml.YAMLError, OSError) as exc:
                errors.append(f"{pkg_id}: compose is unreadable: {exc}")
                doc = {}
            for service, spec in (doc.get("services") or {}).items():
                if not isinstance(spec, dict):
                    continue
                image = str(spec.get("image") or "")
                if not image:
                    errors.append(f"{pkg_id}: {service}: image is required")
                elif "@sha256:" not in image:
                    short = image.rsplit("/", 1)[-1]
                    tag = short.split(":", 1)[1] if ":" in short else ""
                    if (not tag or tag.lower() in FLOATING_TAGS
                            or not re.search(r"\d", tag.split("-", 1)[0])):
                        errors.append(
                            f"{pkg_id}: {service}: image is not pinned to a version or digest: {image}")
                if not spec.get("restart"):
                    errors.append(f"{pkg_id}: {service}: restart policy is required (survives a reboot)")
                if not spec.get("healthcheck"):
                    warnings.append(f"{pkg_id}: {service}: no healthcheck")
                memory_limit = spec.get("mem_limit")
                if not memory_limit:
                    deploy = spec.get("deploy")
                    resources = deploy.get("resources") if isinstance(deploy, dict) else None
                    limits = resources.get("limits") if isinstance(resources, dict) else None
                    memory_limit = limits.get("memory") if isinstance(limits, dict) else None
                if not memory_limit:
                    warnings.append(
                        f"{pkg_id}: {service}: no memory limit — a runaway container can OOM the NAS")
                logging_cfg = spec.get("logging")
                logging_cfg = logging_cfg if isinstance(logging_cfg, dict) else {}
                driver = str(logging_cfg.get("driver") or "json-file").lower()
                log_opts = logging_cfg.get("options")
                log_opts = log_opts if isinstance(log_opts, dict) else {}
                if driver == "json-file" and not (
                        log_opts.get("max-size") and log_opts.get("max-file")):
                    warnings.append(
                        f"{pkg_id}: {service}: no json-file log rotation (max-size/max-file) — logs can fill the disk")
    return errors, warnings


def _readme_row_matches(readme: str, pkg_id: str, version: str) -> bool:
    """True when a README line mentions `pkg_id` together with its current version."""
    mention = re.compile(rf"(?<![a-z0-9-]){re.escape(pkg_id)}(?![a-z0-9-])")
    return any(mention.search(line) and bool(version) and version in line
               for line in readme.splitlines())


def cmd_lint(args) -> int:
    repo = Path(args.repo).resolve()
    index = _read_json(repo / "index.json") if (repo / "index.json").is_file() else {"packages": []}
    versions = {str(e.get("id")): str(e.get("version") or "") for e in index.get("packages") or []}
    readme_path = repo / "README.md"
    readme = readme_path.read_text(encoding="utf-8") if readme_path.is_file() else ""
    errors: list[str] = []
    warnings: list[str] = []
    package_dirs = sorted(p for p in repo.iterdir()
                          if p.is_dir() and not p.name.startswith(".") and (p / "manifest.json").is_file())
    for pkg_dir in package_dirs:
        manifest = _read_json(pkg_dir / "manifest.json")
        errs, warns = _lint_manifest(pkg_dir, manifest)
        errors += errs
        warnings += warns
        pkg_id = str(manifest.get("id") or pkg_dir.name)
        version = str(manifest.get("version") or "")
        if readme and not _readme_row_matches(readme, pkg_id, version):
            errors.append(f"{pkg_id}: README catalog row is missing or shows an older version (v{version})")
        indexed = versions.get(pkg_id)
        if indexed is not None and indexed != version:
            errors.append(f"{pkg_id}: index has v{indexed} but the manifest has v{version}; run build")
    for line in warnings:
        print(f"warning: {line}")
    if errors:
        for line in errors:
            print(f"error: {line}", file=sys.stderr)
        return 1
    print(f"OK: {len(package_dirs)} package(s) linted")
    return 0


def _ui_label(manifest: dict) -> str:
    ui = manifest.get("ui") or {}
    if not ui:
        return "engine"
    if ui.get("mode") == "native":
        return "native"
    return f"window {ui.get('port')}"


def _one_line(text: str, limit: int = 150) -> str:
    value = " ".join(str(text or "").replace("|", "\\|").split())
    if len(value) > limit:
        value = value[: limit - 1].rstrip() + "…"
    return value


def cmd_readme(args) -> int:
    """Regenerate the catalog table between the README markers from index.json."""
    repo = Path(args.repo).resolve()
    index_path = repo / "index.json"
    readme_path = repo / "README.md"
    if not index_path.is_file():
        print("error: index.json is missing; run build first", file=sys.stderr)
        return 1
    if not readme_path.is_file():
        print("error: README.md is missing", file=sys.stderr)
        return 1
    readme = readme_path.read_text(encoding="utf-8")
    if CATALOG_START not in readme or CATALOG_END not in readme:
        print(f"error: README.md needs {CATALOG_START} … {CATALOG_END} around the table",
              file=sys.stderr)
        return 1
    index = _read_json(index_path)
    rows = ["| Package | Version | UI | What it is |", "|---|---|---|---|"]
    for entry in sorted(index.get("packages") or [], key=lambda e: str(e.get("id"))):
        pkg_id = str(entry.get("id"))
        manifest_path = repo / pkg_id / "manifest.json"
        manifest = _read_json(manifest_path) if manifest_path.is_file() else {}
        rows.append(f"| `{pkg_id}` {entry.get('icon') or ''} | {entry.get('version')} | "
                    f"{_ui_label(manifest)} | {_one_line(entry.get('description'))} |")
    head, _, rest = readme.partition(CATALOG_START)
    _, _, tail = rest.partition(CATALOG_END)
    readme_path.write_text(f"{head}{CATALOG_START}\n{chr(10).join(rows)}\n{CATALOG_END}{tail}",
                           encoding="utf-8")
    print(f"wrote the catalog table ({len(rows) - 2} packages) into {readme_path}")
    return 0


def cmd_verify(args) -> int:
    repo = Path(args.repo)
    payload = (repo / "index.json").read_bytes()
    index = json.loads(payload)
    if args.pub:
        pub = base64.b64decode(Path(args.pub).read_bytes().strip(), validate=True)
        sig = base64.b64decode((repo / "index.json.sig").read_bytes().strip(), validate=True)
        try:
            Ed25519PublicKey.from_public_bytes(pub).verify(sig, payload)
        except InvalidSignature:
            print("FAIL: index signature is invalid", file=sys.stderr)
            return 1
        print("OK: index signature")

    failures = []
    for entry in index.get("packages", []):
        pkg_id = entry.get("id")
        manifest_path = repo / pkg_id / "manifest.json"
        if not manifest_path.is_file():
            failures.append(f"{pkg_id}: manifest missing")
            continue
        actual = _sha(manifest_path)
        expected = str(entry.get("manifest_sha256") or "")
        if not SHA_RE.fullmatch(expected) or actual != expected:
            failures.append(f"{pkg_id}: manifest hash mismatch")
            continue
        manifest = _read_json(manifest_path)
        compose = manifest.get("compose") or {}
        if compose.get("sha256"):
            compose_name = str(compose.get("url") or "docker-compose.yml").rstrip("/").rsplit("/", 1)[-1]
            compose_path = repo / pkg_id / compose_name
            if not compose_path.is_file() or _sha(compose_path) != compose["sha256"]:
                failures.append(f"{pkg_id}: compose hash mismatch")
        for item in manifest.get("files") or []:
            path = repo / pkg_id / item["path"]
            if not path.is_file() or _sha(path) != item["sha256"]:
                failures.append(f"{pkg_id}: file hash mismatch: {item['path']}")
        for wheel in (manifest.get("python") or {}).get("wheels") or []:
            wheel_path = repo / pkg_id / "wheels" / wheel["filename"]
            if wheel_path.is_file() and _sha(wheel_path) != wheel["sha256"]:
                failures.append(f"{pkg_id}: wheel hash mismatch: {wheel['filename']}")

    if failures:
        print("FAIL: " + "; ".join(failures), file=sys.stderr)
        return 1
    print(f"OK: {len(index.get('packages', []))} package(s) verified")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Build/sign EthOS package repositories.")
    sub = parser.add_subparsers(dest="command", required=True)

    keygen = sub.add_parser("keygen")
    keygen.add_argument("--out-dir", default=".")
    keygen.add_argument("--force", action="store_true")
    keygen.set_defaults(func=cmd_keygen)

    build = sub.add_parser("build")
    build.add_argument("--repo", required=True)
    build.add_argument("--base-url", required=True)
    build.set_defaults(func=cmd_build)

    sign = sub.add_parser("sign")
    sign.add_argument("--repo", required=True)
    sign.add_argument("--key", default="repo.key")
    sign.set_defaults(func=cmd_sign)

    verify = sub.add_parser("verify")
    verify.add_argument("--repo", required=True)
    verify.add_argument("--pub", default="")
    verify.set_defaults(func=cmd_verify)

    lint = sub.add_parser("lint")
    lint.add_argument("--repo", required=True)
    lint.set_defaults(func=cmd_lint)

    readme = sub.add_parser("readme")
    readme.add_argument("--repo", required=True)
    readme.set_defaults(func=cmd_readme)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
