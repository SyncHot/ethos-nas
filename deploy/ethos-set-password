#!/usr/bin/python3
"""Narrow root helper for the EthOS first-run setup ("claim this appliance").

The image boots with one locked admin account and a pending setup state
(``/etc/ethos-nas/setup.json``) written by ``ethos-firstboot``. The browser
setup screen posts a claim code plus the password the operator chose; the API
verifies the code and hands the request to this helper, which is the only code
allowed to touch the password database (``chpasswd`` needs root, the service
runs as ``ethos-nas``).

Security boundary — everything below is enforced here, not in the caller:

* the helper accepts exactly one request shape and refuses any argv;
* setup must still be pending: the state file has to exist and ``claimed_at``
  must be unset, so the helper is usable at most once per image;
* the account must be the one recorded in the state file — an image can only
  ever provision its own admin, never root or another account;
* the account has to be a real interactive user (uid >= 1000);
* the password is passed on **stdin** (never argv), must satisfy the length
  policy, and is written with ``chpasswd``;
* after success the state file is rewritten with ``claimed_at`` (atomic
  replace), which closes the door even if a caller loops.

Runs only as root; ``/etc/sudoers.d/ethos-nas`` grants it argument-free.
"""

import datetime
import grp
import json
import os
import pwd
import re
import subprocess
import sys
from pathlib import Path

STATE_FILE = Path("/etc/ethos-nas/setup.json")
SERVICE_GROUP = "ethos-nas"
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
MIN_PASSWORD = 10
MAX_PASSWORD = 200
MAX_REQUEST_BYTES = 4096
COMMAND_TIMEOUT = 20
# Names that must never be handed out to the first-run wizard: system accounts
# and the EthOS service account (the helper itself runs as root, but a
# mis-typed name here would still break the appliance).
RESERVED_USERNAMES = frozenset({
    "root", "daemon", "bin", "sys", "sync", "games", "man", "lp", "mail",
    "news", "uucp", "proxy", "www-data", "backup", "list", "irc", "gnats",
    "nobody", "systemd-network", "systemd-resolve", "messagebus", "sshd",
    "avahi", "ethos-nas", "ethosadmin",
})
ALLOWED_KEYS = frozenset({"action", "username", "password", "new_username"})


class HelperError(ValueError):
    """A request the helper refuses to carry out."""


def _read_state() -> dict:
    try:
        state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        raise HelperError("First-run setup is not pending") from None
    if not isinstance(state, dict):
        raise HelperError("First-run setup state is invalid")
    if state.get("claimed_at"):
        raise HelperError("First-run setup is already complete")
    user = state.get("user")
    if not isinstance(user, str) or not USERNAME_RE.fullmatch(user):
        raise HelperError("First-run setup state is invalid")
    return state


def _password(value) -> str:
    if not isinstance(value, str):
        raise HelperError("Password must be a string")
    if len(value) < MIN_PASSWORD:
        raise HelperError(f"Password must be at least {MIN_PASSWORD} characters")
    if len(value) > MAX_PASSWORD:
        raise HelperError("Password is too long")
    if value != value.strip():
        raise HelperError("Password must not start or end with whitespace")
    if value.isdigit() or value.isalpha():
        raise HelperError("Use letters and digits, not just one kind of character")
    if "\n" in value or ":" in value:
        raise HelperError("Password must not contain ':' or a line break")
    return value


def _run(args: list[str], *, stdin: str | None = None) -> None:
    try:
        result = subprocess.run(
            args, input=stdin, capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        raise HelperError("Password tooling is unavailable or timed out") from None
    if result.returncode:
        raise HelperError("Password change failed")


def _mark_claimed(state: dict, user: str | None = None) -> None:
    """Rewrite the state file with `claimed_at`, keeping it readable by the service."""
    state = dict(state)
    if user:
        state["user"] = user
    state["claimed_at"] = (
        datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()
    )
    try:
        gid = grp.getgrnam(SERVICE_GROUP).gr_gid
    except KeyError:
        gid = 0  # no service group (test host): root-owned is the safe default
    tmp = STATE_FILE.with_name(STATE_FILE.name + ".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    try:
        os.chown(tmp, 0, gid)
    except PermissionError:
        # Not root (unit tests import this module directly); ownership only
        # matters for the service user on a real appliance.
        pass
    os.chmod(tmp, 0o640)
    tmp.replace(STATE_FILE)


def _new_username(value: str, source: str) -> str:
    """Validate a login name the operator chose at first boot."""
    name = str(value or "").strip()
    if name == source:
        return name  # keeping the image's name is always allowed
    if not USERNAME_RE.fullmatch(name):
        raise HelperError(
            "Use lowercase letters, digits, '-' and '_' (max 32, not a trailing '-')")
    if name.endswith("-"):
        raise HelperError("The username must not end with '-'")
    if name in RESERVED_USERNAMES:
        raise HelperError("That username is reserved")
    try:
        pwd.getpwnam(name)
    except KeyError:
        return name
    raise HelperError("That username is already taken")


def _rename_account(source: str, target: str) -> None:
    """Rename the image's admin account (and its private group) in place.

    Renaming keeps the uid, the sudo/adm/render/video groups and the home
    directory contents, so the appliance still has exactly one admin. It has to
    happen in one `usermod` call: `-l` alone leaves the home directory pointing
    at a path that no longer matches the login name.
    """
    try:
        account = pwd.getpwnam(source)
    except KeyError:
        raise HelperError("Linux account not found") from None
    if account.pw_uid < 1000:
        raise HelperError("System accounts cannot be provisioned")
    home = Path(account.pw_dir)
    args = ["usermod", "-l", target]
    if home.is_dir():
        args += ["-d", str(home.parent / target), "-m"]
    args.append(source)
    _run(args)
    try:
        primary = grp.getgrgid(account.pw_gid).gr_name
    except KeyError:
        primary = ""
    if primary == source:
        # useradd created a group with the same name; leaving it behind would
        # show a stranger's name on every file the admin owns.
        _run(["groupmod", "-n", target, source])


def handle_request(request) -> dict:
    if not isinstance(request, dict):
        raise HelperError("Request must be a JSON object")
    if not set(request) <= ALLOWED_KEYS or not {"action", "username", "password"} <= set(request):
        raise HelperError("Invalid request")
    if request.get("action") != "setup-password":
        raise HelperError("Unknown setup action")

    state = _read_state()
    username = request.get("username")
    if not isinstance(username, str) or username != state["user"]:
        # Never name the accepted account in the error: the caller should not be
        # able to probe which account an image would provision.
        raise HelperError("This account cannot be provisioned")
    password = _password(request.get("password"))

    try:
        account = pwd.getpwnam(username)
    except KeyError:
        raise HelperError("Linux account not found") from None
    if account.pw_uid < 1000:
        raise HelperError("System accounts cannot be provisioned")

    chosen = _new_username(request.get("new_username") or username, username)
    if chosen != username:
        _rename_account(username, chosen)

    _run(["chpasswd"], stdin=f"{chosen}:{password}\n")
    # The operator chose this password a second ago: it must not be "expired",
    # which is what a first-boot image ships to force a console change.
    _run(["chage", "-d", datetime.date.today().isoformat(), chosen])
    try:
        _mark_claimed(state, user=chosen)
    except OSError as exc:
        # The password is set — do not report a failure the operator would read
        # as "nothing happened". A second claim would still need the code.
        print(f"Warning: could not mark setup complete: {exc}", file=sys.stderr)
    return {"ok": True, "username": chosen}


def main() -> int:
    if os.geteuid() != 0:
        print("Setup helper must run as root", file=sys.stderr)
        return 1
    if len(sys.argv) != 1:
        print("This helper accepts requests only through stdin", file=sys.stderr)
        return 1
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        print("Request too large", file=sys.stderr)
        return 1
    try:
        response = handle_request(json.loads(raw))
    except (UnicodeDecodeError, json.JSONDecodeError):
        print("Request must be JSON", file=sys.stderr)
        return 1
    except HelperError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    sys.stdout.write(json.dumps(response, separators=(",", ":")) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
