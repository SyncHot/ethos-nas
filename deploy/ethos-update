#!/bin/bash
# ethos-update — privileged helper for EthOS NAS core updates.
#
# Installed by setup_scripts/setup_service.sh as /usr/local/bin/ethos-update,
# invoked by the service through one ARGUMENT-FREE sudoers rule:
#
#   sudo -n /usr/local/bin/ethos-update
#
# Everything that decides *what* to install comes from the signed release index
# and from /etc/ethos-nas/update.conf (root-owned). The web UI can only ask for
# "apply the published release" by dropping `<DATA_DIR>/update/request.json`;
# it cannot supply a URL, a commit or a command.
#
# Flow (git-checkout installs):
#   fetch signed index -> verify Ed25519 signature (openssl) -> take the signed
#   commit -> git fetch -> git reset --hard <sha> (as the repo owner) ->
#   pip install -r requirements.txt -> systemctl restart -> poll :9000 for 90 s.
#   Any failure (or an unhealthy service) restores the previous commit and
#   dependencies and restarts again.
#
# Progress/result JSON files live in <DATA_DIR>/update/ so the web UI can report
# them after the restart.
set -euo pipefail

# Never let a git command wait for credentials: an appliance has no terminal, so
# a prompt used to hang the helper forever (the UI showed "fetch" and no
# progress). Fail fast instead — the trap below reports it.
export GIT_TERMINAL_PROMPT=0

CONF="/etc/ethos-nas/update.conf"
LOCK="/run/ethos-update.lock"
WORK="/var/lib/ethos-update"
HEALTH_URL="http://127.0.0.1:9000/api/system/status"
HEALTH_TIMEOUT=90

log() { printf 'ethos-update: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit "${2:-1}"; }

if [ "$(id -u)" -ne 0 ]; then
    die "must run as root (via sudo)"
fi
if [ "$#" -ne 0 ]; then
    die "this helper takes no arguments" 2
fi

# ── Survive the restart this helper performs ────────────────────────────────
# `systemctl restart ethos-nas` stops every process in the unit's cgroup, which
# used to kill this helper at its own "restart" step: job.json stayed
# "running" forever and every later update was refused with 409. Re-exec once
# in a transient systemd scope owned by PID 1, which the restart leaves alone.
if [ -z "${ETHOS_UPDATE_SCOPED:-}" ] && [ -d /run/systemd/system ] \
        && command -v systemd-run >/dev/null 2>&1; then
    exec systemd-run --scope --collect --quiet --unit="ethos-update-$$" \
        --setenv=ETHOS_UPDATE_SCOPED=1 -- "$0"
fi

[ -r "${CONF}" ] || die "missing ${CONF} — re-run setup_scripts/setup_service.sh"

# shellcheck disable=SC1090
. "${CONF}"

for var in INSTALL_DIR REPO_OWNER SERVICE_USER SERVICE_UNIT DATA_DIR INDEX_URL PUBKEY_PEM; do
    [ -n "${!var:-}" ] || die "${CONF} does not define ${var}"
done

# The owner of the install directory is not stable across the appliance's life:
# an image built by the builder's account is claimed by the admin created at
# first boot, and update.conf is written once at install time. A stale owner made
# runuser fail *before* any result was written, so the web UI kept polling a job
# stuck at step "fetch". Resolve it here instead of trusting the file.
if ! id -u "${REPO_OWNER}" >/dev/null 2>&1; then
    RESOLVED_OWNER="$(stat -c %U "${INSTALL_DIR}" 2>/dev/null || true)"
    { [ -n "${RESOLVED_OWNER}" ] && id -u "${RESOLVED_OWNER}" >/dev/null 2>&1; } \
        || die "REPO_OWNER '${REPO_OWNER}' does not exist and ${INSTALL_DIR} has no usable owner; re-run setup_scripts/setup_service.sh" 6
    log "warning: REPO_OWNER '${REPO_OWNER}' does not exist — using '${RESOLVED_OWNER}' (owner of ${INSTALL_DIR})"
    REPO_OWNER="${RESOLVED_OWNER}"
fi
STATE_DIR="${DATA_DIR}/update"
JOB="${STATE_DIR}/job.json"
RESULT="${STATE_DIR}/result.json"
REQUEST="${STATE_DIR}/request.json"
FROM_SHA=""
TARGET_SHA=""
TARGET_VERSION=""

# ── Single instance ─────────────────────────────────────────────────────────
exec 9>"${LOCK}" || die "cannot open ${LOCK}"
flock -n 9 || die "another update is already running" 3

mkdir -p "${WORK}" "${STATE_DIR}"
chmod 0755 "${WORK}"

# ── JSON state (fixed fields, values passed as argv — no dynamic code) ───────
json_write() {  # <path> <status> <step> <from> <to> <version> <detail>
    OWN_UID="$(id -u "${SERVICE_USER}")" OWN_GID="$(id -g "${SERVICE_USER}")" \
    python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" <<'PY'
import json, os, sys, datetime

path, status, step, frm, to, version, detail = sys.argv[1:8]
data = {
    "status": status,
    "step": step,
    "from": frm,
    "to": to,
    "version": version,
    "detail": detail,
    # The backend polls /proc/<pid> to tell a hung helper from a dead one: a
    # killed helper used to leave job.json at "running" for hours.
    "pid": os.getppid(),
    "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
}
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, ensure_ascii=False)
    fh.flush()
    os.fsync(fh.fileno())
os.replace(tmp, path)
os.chmod(path, 0o644)
try:
    os.chown(path, int(os.environ["OWN_UID"]), int(os.environ["OWN_GID"]))
except (KeyError, PermissionError):
    pass
PY
}

step() {  # step <name> [detail]
    CURRENT_STEP="$1"
    json_write "${JOB}" "running" "$1" "${FROM_SHA}" "${TARGET_SHA}" "${TARGET_VERSION}" "${2:-}"
    log "step: $1${2:+ ($2)}"
}

finish() {  # finish <status> [detail]
    json_write "${RESULT}" "$1" "done" "${FROM_SHA}" "${TARGET_SHA}" "${TARGET_VERSION}" "${2:-}"
    json_write "${JOB}" "$1" "done" "${FROM_SHA}" "${TARGET_SHA}" "${TARGET_VERSION}" "${2:-}"
    rm -f "${REQUEST}"
    RESULT_WRITTEN=1
    log "result: $1 ${2:-}"
}

rollback() {  # rollback <reason>
    local reason="$1"
    log "rolling back: ${reason}"
    step "rollback" "${reason}"
    runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" reset --hard "${FROM_SHA}" >/dev/null
    runuser -u "${REPO_OWNER}" -- "${INSTALL_DIR}/.venv/bin/pip" install \
        --disable-pip-version-check -q -r "${INSTALL_DIR}/requirements.txt" || true
    # Restore the privileged configuration of the *previous* release before it
    # restarts: the failed update may already have installed new helpers,
    # sudoers rules or a unit file.
    if [ -x /usr/local/bin/ethos-provision ] && [ -f "${INSTALL_DIR}/deploy/provision.json" ]; then
        /usr/local/bin/ethos-provision || log "warning: provisioning rollback failed"
    fi
    systemctl restart "${SERVICE_UNIT}" || true
    for _ in $(seq 1 "${HEALTH_TIMEOUT}"); do
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "${HEALTH_URL}" || true)"
        if [ "${code}" = "200" ] || [ "${code}" = "401" ]; then
            finish "rolled_back" "${reason}"
            exit 0
        fi
        sleep 1
    done
    finish "failed" "${reason}; rollback did not come back healthy"
    exit 1
}

# ── Request gate ────────────────────────────────────────────────────────────# Every exit path must leave a terminal state behind. `die` used to return
# without touching result.json, so the web UI polled job.json (= "running")
# until the two-hour staleness window expired — "the update spins forever".
RESULT_WRITTEN=0
CURRENT_STEP="start"
on_exit() {
    local rc=$?
    if [ "${RESULT_WRITTEN}" -eq 0 ] && [ "${rc}" -ne 0 ]; then
        local detail="update helper exited (code ${rc}) during step ${CURRENT_STEP}"
        json_write "${RESULT}" "failed" "done" "${FROM_SHA}" "${TARGET_SHA}" "${TARGET_VERSION}" "${detail}" || true
        json_write "${JOB}" "failed" "done" "${FROM_SHA}" "${TARGET_SHA}" "${TARGET_VERSION}" "${detail}" || true
        rm -f "${REQUEST}" || true
        log "result: failed ${detail}"
    fi
}
trap on_exit EXIT
[ -f "${REQUEST}" ] || die "no update requested (${REQUEST} is missing)" 4
if ! python3 - "${REQUEST}" <<'PY'
import json, sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)
raise SystemExit(0 if isinstance(data, dict) and data.get("action") == "apply" else 1)
PY
then
    rm -f "${REQUEST}"
    die "request file is not a valid apply request" 4
fi

# ── Signed index ────────────────────────────────────────────────────────────
step "fetch" "release index"
IDX="${WORK}/index.json"
SIG="${WORK}/index.json.sig"
rm -f "${IDX}" "${SIG}"
curl -fsSL --proto '=https' --tlsv1.2 --max-time 30 --max-filesize 262144 \
    "${INDEX_URL}" -o "${IDX}" || die "could not fetch ${INDEX_URL}" 5
curl -fsSL --proto '=https' --tlsv1.2 --max-time 30 --max-filesize 4096 \
    "${INDEX_URL}.sig" -o "${SIG}" || die "could not fetch the index signature" 5
[ -s "${PUBKEY_PEM}" ] || die "missing public key: ${PUBKEY_PEM}" 5

base64 -d "${SIG}" > "${WORK}/index.sig.bin" 2>/dev/null || die "signature is not base64" 5
openssl pkeyutl -verify -pubin -inkey "${PUBKEY_PEM}" -rawin \
    -in "${IDX}" -sigfile "${WORK}/index.sig.bin" >/dev/null 2>&1 \
    || die "release index signature is invalid" 5
log "signature OK"

read_index_field() {  # read_index_field <sha|version>
    python3 - "$1" "${IDX}" <<'PY'
import json, sys

field, path = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
if data.get("schema") != 1:
    raise SystemExit("unsupported index schema")
latest = data.get("latest") or {}
sha = str(latest.get("git_sha_full") or latest.get("git_sha") or "")
if not sha or any(c not in "0123456789abcdefABCDEF" for c in sha):
    raise SystemExit("index has no usable commit sha")
print(sha if field == "sha" else str(latest.get("version") or ""))
PY
}
TARGET_SHA="$(read_index_field sha)" || die "could not read the signed index" 5
TARGET_VERSION="$(read_index_field version)" || die "could not read the signed index" 5

# ── Git checkout only (artifact/tarball installs are not supported yet) ─────
[ -d "${INSTALL_DIR}/.git" ] || die "${INSTALL_DIR} is not a git checkout" 6
FROM_SHA="$(runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" rev-parse HEAD)"
if [ "${FROM_SHA}" = "${TARGET_SHA}" ]; then
    finish "up_to_date" "already on ${TARGET_VERSION:-$TARGET_SHA}"
    exit 0
fi

step "apply" "git fetch + reset"
# EthOS OS images ship a single-tag refspec (`fetch = +refs/tags/<pin>:refs/tags/<pin>`),
# so a plain `git fetch` can never see a *newer* tag. Pass explicit refspecs to
# behave like a normal clone, and bound every fetch: an unreachable or
# credential-requiring remote must fail the update, not stall it.
FETCH_TIMEOUT="${FETCH_TIMEOUT:-600}"
timeout "${FETCH_TIMEOUT}" runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" fetch --prune origin \
    '+refs/heads/*:refs/remotes/origin/*' '+refs/tags/*:refs/tags/*' >/dev/null 2>&1 \
    || rollback "git fetch failed"
# The OS image ships a --depth 1 clone (small download, fast first boot), and a
# released commit is almost always an *ancestor* of the new tip: a shallow
# fetch moves the tip but cannot see that commit, which used to abort the
# update with "signed commit … is not present after fetch". Fetch the exact
# commit first (cheap), then deepen the clone if the server refuses.
if ! runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" cat-file -e "${TARGET_SHA}^{commit}" 2>/dev/null; then
    step "apply" "fetch the signed commit"
    timeout "${FETCH_TIMEOUT}" runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" fetch \
        --depth=1 origin "${TARGET_SHA}" >/dev/null 2>&1 || true
fi
if ! runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" cat-file -e "${TARGET_SHA}^{commit}" 2>/dev/null; then
    step "apply" "deepen the shallow clone"
    timeout "${FETCH_TIMEOUT}" runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" fetch --unshallow origin \
        >/dev/null 2>&1 \
        || timeout "${FETCH_TIMEOUT}" runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" fetch --depth=200 origin \
            >/dev/null 2>&1 \
        || true
fi
runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" cat-file -e "${TARGET_SHA}^{commit}" 2>/dev/null \
    || rollback "signed commit ${TARGET_SHA} is not present after fetch"
runuser -u "${REPO_OWNER}" -- git -C "${INSTALL_DIR}" reset --hard "${TARGET_SHA}" >/dev/null \
    || rollback "git reset --hard failed"

step "deps" "pip install"
runuser -u "${REPO_OWNER}" -- "${INSTALL_DIR}/.venv/bin/pip" install \
    --disable-pip-version-check -q -r "${INSTALL_DIR}/requirements.txt" \
    || rollback "dependency install failed"

# Apply the privileged configuration from the signed checkout (helpers, the
# separate ethos-nas-provided sudoers file, the systemd unit, allowlisted
# confs). A failure aborts the update before the restart, which triggers the
# code rollback above — and that rollback re-provisions the previous release.
step "provision" "privileged configuration"
if [ -x /usr/local/bin/ethos-provision ] && [ -f "${INSTALL_DIR}/deploy/provision.json" ]; then
    /usr/local/bin/ethos-provision || rollback "system provisioning failed"
else
    log "warning: ethos-provision is not installed — run setup_service.sh once"
    # Old installs: refresh the helpers directly, but only when the service
    # user cannot have modified them. A checkout writable by the backend would
    # otherwise turn the next update into arbitrary root code execution.
    SERVICE_UID="$(id -u "${SERVICE_USER}")"
    SERVICE_GIDS=" $(id -G "${SERVICE_USER}") "
    check_helper_source() {
        local src="$1"
        [ -f "${src}" ] || return 0
        local uid gid mode
        uid="$(stat -c %u "${src}")"
        gid="$(stat -c %g "${src}")"
        mode="$(stat -c %a "${src}")"
        [ "${uid}" != "${SERVICE_UID}" ] \
            || die "refusing ${src}: owned by ${SERVICE_USER}" 7
        [ $((10#${mode} & 002)) -eq 0 ] \
            || die "refusing ${src}: world-writable" 7
        if [ $((10#${mode} & 020)) -ne 0 ] && [[ "${SERVICE_GIDS}" == *" ${gid} "* ]]; then
            die "refusing ${src}: group-writable by ${SERVICE_USER}" 7
        fi
    }
    check_helper_source "${INSTALL_DIR}/deploy/ethos-update"
    if [ -f "${INSTALL_DIR}/deploy/ethos-update" ]; then
        if install -m 0755 "${INSTALL_DIR}/deploy/ethos-update" "/usr/local/bin/ethos-update.new"; then
            mv -f "/usr/local/bin/ethos-update.new" "/usr/local/bin/ethos-update" \
                || log "warning: could not replace the installed helper — continuing"
        else
            log "warning: could not stage the updated helper — continuing"
        fi
    fi
    if [ -x /usr/local/bin/ethos-os-update ] && [ -f "${INSTALL_DIR}/deploy/ethos-os-update" ]; then
        check_helper_source "${INSTALL_DIR}/deploy/ethos-os-update"
        if install -m 0755 "${INSTALL_DIR}/deploy/ethos-os-update" "/usr/local/bin/ethos-os-update.new"; then
            mv -f "/usr/local/bin/ethos-os-update.new" "/usr/local/bin/ethos-os-update" \
                || log "warning: could not replace the OS update helper — continuing"
        else
            log "warning: could not stage the OS update helper — continuing"
        fi
    fi
fi

step "restart" "${SERVICE_UNIT}"
systemctl restart "${SERVICE_UNIT}" || rollback "systemctl restart failed"

step "verify" "health probe"
for _ in $(seq 1 "${HEALTH_TIMEOUT}"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "${HEALTH_URL}" || true)"
    if [ "${code}" = "200" ] || [ "${code}" = "401" ]; then
        finish "ok" "updated to ${TARGET_VERSION:-$TARGET_SHA}"
        exit 0
    fi
    sleep 1
done
rollback "service did not become healthy within ${HEALTH_TIMEOUT}s"
