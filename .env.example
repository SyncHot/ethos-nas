# EthOS NAS — example environment file
#
# Copy to `.env` (0600) next to this file, or put the same keys in
# /etc/ethos-nas/ethos.env (loaded by the systemd unit). Real environment
# variables always win over this file.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit `.env`.

# ── Required for a real installation ─────────────────────────────────────────
# JWT signing key. Generate with: openssl rand -hex 32
# When this is empty the app generates a random secret once and keeps it in
# <DATA_DIR>/jwt_secret (0600). The built-in placeholder is only used when
# ETHOS_ALLOW_INSECURE=1 is set explicitly.
ETHOS_JWT_SECRET=

# ── Listener ─────────────────────────────────────────────────────────────────
# ETHOS_HOST=0.0.0.0
# ETHOS_PORT=9000
# ETHOS_CORS_ORIGINS=http://localhost,http://127.0.0.1

# ── State ────────────────────────────────────────────────────────────────────
# Override to run a second, fully isolated instance (tests, staging).
# ETHOS_DATA_DIR=/var/lib/ethos-nas/data

# ── Package Center source ────────────────────────────────────────────────────
# Defaults to the signed EthOS community repository. Set to 0 to start with no
# source at all (air-gapped installs).
# ETHOS_PACKAGES_DEFAULT_SOURCE=true
# ETHOS_PACKAGES_DEFAULT_SOURCE_URL=https://raw.githubusercontent.com/SyncHot/ethos-packages/main/index.json

# ── Android APK delivery ─────────────────────────────────────────────────────
# The server looks in <install>/apks/<app>/ first. Override only if your build
# pipeline writes somewhere else.
# ETHOS_MOMENTS_APK_PATH=/srv/apks/moments/app-release.apk
# ETHOS_MUSIC_APK_PATH=/srv/apks/music/app-release.apk
# ETHOS_VIDEO_APK_PATH=/srv/apks/video/app-release.apk

# ── Offsite backup (rclone) ──────────────────────────────────────────────────
# Path to an rclone config file. Credentials never pass through the API.
# ETHOS_RCLONE_CONFIG=/var/lib/ethos-nas/rclone.conf

# ── Development only ─────────────────────────────────────────────────────────
# Allow the built-in JWT secret and an insecure package transport. Never use
# these on a reachable NAS.
# ETHOS_ALLOW_INSECURE=1
# ETHOS_PACKAGES_ALLOW_INSECURE=1

# ── Core update check (docs/updates.md) ──────────────────────────────────────
# Signed release index; nothing is installed from here.
# ETHOS_UPDATE_ENABLED=true
# ETHOS_UPDATE_INDEX_URL=https://raw.githubusercontent.com/SyncHot/ethos-nas/master/releases/index.json
# ETHOS_UPDATE_CHECK_HOURS=24
