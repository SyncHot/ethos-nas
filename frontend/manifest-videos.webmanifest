{
  "name": "EthOS Videos",
  "short_name": "Videos",
  "description": "Watch your NAS library on the phone: resume, subtitles, fullscreen and offline downloads.",
  "id": "/videos",
  "start_url": "/videos",
  "scope": "/videos",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["video", "entertainment"],
  "icons": [
    {
      "src": "/static/icons/videos-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/videos-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/videos-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Downloads",
      "short_name": "Downloads",
      "url": "/videos?view=downloads",
      "icons": [{ "src": "/static/icons/videos-192.png", "sizes": "192x192" }]
    }
  ]
}
