{
  "name": "EthOS Books",
  "short_name": "Books",
  "description": "Audiobooki, EPUB i PDF z NAS-a na telefonie: słuchanie w tle i pobieranie offline.",
  "id": "/books",
  "start_url": "/books",
  "scope": "/books",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#12100e",
  "theme_color": "#12100e",
  "categories": ["books", "education", "entertainment"],
  "icons": [
    {
      "src": "/static/icons/books-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/books-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/books-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Słucham",
      "short_name": "Słucham",
      "url": "/books?view=continue",
      "icons": [{ "src": "/static/icons/books-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pobrane",
      "short_name": "Pobrane",
      "url": "/books?view=downloads",
      "icons": [{ "src": "/static/icons/books-192.png", "sizes": "192x192" }]
    }
  ]
}
