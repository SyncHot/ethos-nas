{
  "name": "Sticky Notes",
  "short_name": "Notes",
  "description": "Quick notes and checklist tasks from your EthOS NAS.",
  "id": "/notes",
  "start_url": "/notes",
  "scope": "/notes",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f6f1e7",
  "theme_color": "#b45309",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/static/icons/notes-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/notes-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/notes-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "url": "/notes?new=note",
      "icons": [{ "src": "/static/icons/notes-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New task",
      "short_name": "New task",
      "url": "/notes?new=checklist",
      "icons": [{ "src": "/static/icons/notes-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/notes",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
